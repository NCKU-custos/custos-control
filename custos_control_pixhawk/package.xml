<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>custos_control_pixhawk</name>
  <version>0.1.0</version>
  <description>Pixhawk bridge for the Custos drone stack. Translates Pixhawk uXRCE-DDS or MAVROS streams into custos_control_msgs topics and services.</description>
  <maintainer email="opensource@custos.dev">Custos Flight</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>lifecycle_msgs</depend>
  <depend>custos_common_msgs</depend>
  <depend>custos_control_msgs</depend>

  <test_depend>ament_lint_auto</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
